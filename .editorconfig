root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 120
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx,json,jsonc,yaml,yml,toml,css,html,tf,hcl}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8
max_line_length = off

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 8

[*.md]
max_line_length = off
