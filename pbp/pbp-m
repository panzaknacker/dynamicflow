def start_ssh_control_master(
    target: Target,
    ssh_port: int,
    identity: Path,
    known_hosts: Path,
) -> SSHControlMaster:
    ssh = resolve_executable(None, name="ssh", fallback=Path("/usr/bin/ssh"))
    common = provisioning_ssh_arguments(ssh, target, ssh_port, identity, known_hosts)
    temporary = tempfile.TemporaryDirectory(prefix="pbp-m-ssh-")
    socket_path = Path(temporary.name) / "control"
    command = [
        str(ssh),
        *common,
        "-M",
        "-S",
        str(socket_path),
        "-o",
        "ControlMaster=yes",
        "-o",
        "ControlPersist=no",
        "-N",
        "-T",
        "--",
        target.ssh_destination,
    ]
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            env=connector_environment(),
        )
    except OSError as exc:
        temporary.cleanup()
        raise UserError("Die abgesicherte SSH-Provisioning-Verbindung konnte nicht gestartet werden.") from exc

    deadline = time.monotonic() + SSH_CONNECT_TIMEOUT + 10
    while time.monotonic() < deadline:
        returncode = process.poll()
        if returncode is not None:
            temporary.cleanup()
            raise UserError(f"Die abgesicherte SSH-Provisioning-Verbindung endete mit Exit {returncode}.")
        if socket_path.exists():
            try:
                check = subprocess.run(
                    [
                        str(ssh),
                        *common,
                        "-S",
                        str(socket_path),
                        "-O",
                        "check",
                        "--",
                        target.ssh_destination,
                    ],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                    timeout=5,
                    env=connector_environment(),
                )
            except (OSError, subprocess.TimeoutExpired):
                check = None
            if check is not None and check.returncode == 0:
                return SSHControlMaster(
                    ssh=ssh,
                    common_arguments=common,
                    destination=target.ssh_destination,
                    socket_path=socket_path,
                    process=process,
                    temporary=temporary,
                )
        time.sleep(0.1)

    try:
        process.terminate()
        process.wait(timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        try:
            process.kill()
            process.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            pass
    temporary.cleanup()
    raise UserError("Zeitlimit beim Aufbau der abgesicherten SSH-Provisioning-Verbindung.")


def stop_ssh_control_master(master: SSHControlMaster) -> None:
    if master.process.poll() is None:
        try:
            subprocess.run(
                [
                    str(master.ssh),
                    *master.common_arguments,
                    "-S",
                    str(master.socket_path),
                    "-O",
                    "exit",
                    "--",
                    master.destination,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
                timeout=5,
                env=connector_environment(),
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    try:
        master.process.wait(timeout=3)
    except subprocess.TimeoutExpired:
        try:
            master.process.terminate()
            master.process.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            try:
                master.process.kill()
                master.process.wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                pass
    finally:
        master.temporary.cleanup()


def run_remote_bounded(
    command: Sequence[str],
    timeout: int,
) -> subprocess.CompletedProcess[bytes]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env=connector_environment(),
    )
    if process.stdout is None:
        process.kill()
        process.wait()
        raise OSError("Remote-Prozess hat keinen lesbaren Ausgabekanal.")

    output = bytearray()
    deadline = time.monotonic() + timeout
    descriptor = process.stdout.fileno()
    try:
        os.set_blocking(descriptor, False)
        while True:
            read_limit = min(4096, MAX_REMOTE_OUTPUT + 1 - len(output))
            try:
                chunk = os.read(descriptor, read_limit)
            except BlockingIOError:
                chunk = None

            if chunk == b"":
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout)
                try:
                    returncode = process.wait(timeout=remaining)
                except subprocess.TimeoutExpired:
                    raise subprocess.TimeoutExpired(command, timeout) from None
                return subprocess.CompletedProcess(command, returncode, bytes(output), b"")
            if chunk:
                output.extend(chunk)
                if len(output) > MAX_REMOTE_OUTPUT:
                    raise UserError(f"Remote-Ausgabe überschritt das feste {MAX_REMOTE_OUTPUT}-Byte-Limit.")
            if time.monotonic() >= deadline:
                raise subprocess.TimeoutExpired(command, timeout)
            if chunk is None:
                time.sleep(0.02)
    except BaseException:
        if process.poll() is None:
            try:
                process.kill()
            except OSError:
                pass
        try:
            process.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            pass
        raise
    finally:
        process.stdout.close()


def remote_command(
    master: SSHControlMaster,
    remote_script: str,
    *,
    label: str,
    timeout: int,
    allocate_tty: bool = False,
    capture: bool = True,
) -> bytes:
    if allocate_tty and capture:
        raise UserError("Interner Fehler: TTY-Remote-Befehle dürfen nicht gepuffert werden.")
    command = [
        str(master.ssh),
        *master.common_arguments,
        "-S",
        str(master.socket_path),
        "-tt" if allocate_tty else "-T",
        "--",
        master.destination,
        remote_script,
    ]
    tty_descriptor: int | None = None
    try:
        if capture:
            result = run_remote_bounded(command, timeout)
        else:
            if allocate_tty:
                tty_descriptor = os.open(
                    "/dev/tty",
                    os.O_RDWR | getattr(os, "O_CLOEXEC", 0),
                )
                if not os.isatty(tty_descriptor):
                    raise UserError("Mullvad-Dialog benötigt ein kontrollierendes /dev/tty.")
            result = subprocess.run(
                command,
                stdin=tty_descriptor if tty_descriptor is not None else subprocess.DEVNULL,
                stdout=tty_descriptor if tty_descriptor is not None else None,
                stderr=tty_descriptor if tty_descriptor is not None else None,
                check=False,
                timeout=timeout,
                env=connector_environment(),
            )
    except subprocess.TimeoutExpired as exc:
        raise UserError(f"{label} überschritt das feste Zeitlimit.") from exc
    except OSError as exc:
        raise UserError(f"{label} konnte nicht über SSH gestartet werden.") from exc
    finally:
        if tty_descriptor is not None:
            os.close(tty_descriptor)
    output = result.stdout or b""
    if result.returncode != 0:
        detail = output.decode("utf-8", errors="replace").strip()
        if detail:
            write_stderr(detail)
        raise UserError(f"{label} schlug fehl (Exit {result.returncode}).")
    return output


def remote_preflight(master: SSHControlMaster) -> str:
    script = (
        "set -eu\n"
        'test "$(id -u)" -ne 0\n'
        "sudo -n true\n"
        "test -d /run/systemd/system\n"
        "if command -v cloud-init >/dev/null 2>&1; then "
        "sudo -n timeout 300 cloud-init status --wait >/dev/null; fi\n"
        "test -r /etc/os-release\n"
        ". /etc/os-release\n"
        "command -v dpkg >/dev/null 2>&1\n"
        'case "$ID" in\n'
        '  debian) dpkg --compare-versions "$VERSION_ID" ge 12 ;;\n'
        '  ubuntu) dpkg --compare-versions "$VERSION_ID" ge 24.04 ;;\n'
        "  *) exit 41 ;;\n"
        "esac\n"
        'arch="$(dpkg --print-architecture)"\n'
        'case "$arch" in amd64|arm64) ;; *) exit 42 ;; esac\n'
        'printf \'PBP_PREFLIGHT %s %s %s\\n\' "$ID" "$VERSION_ID" "$arch"\n'
    )
    output = remote_command(
        master,
        script,
        label="Remote-Preflight",
        timeout=REMOTE_PREFLIGHT_TIMEOUT,
    )
    matches = re.findall(
        rb"^PBP_PREFLIGHT (debian|ubuntu) ([0-9][0-9.]*) (amd64|arm64)$",
        output,
        flags=re.MULTILINE,
    )
    if len(matches) != 1:
        raise UserError(
            "Remote-Preflight bestätigte nicht eindeutig Debian 12+/Ubuntu 24.04+, systemd, sudo und Architektur."
        )
    distro, version, architecture = (part.decode("ascii") for part in matches[0])
    write_stderr(f"  OK VM: {distro} {version}, {architecture}, passwordloses sudo verfügbar.")
    return architecture


def fresh_ssh_check(master: SSHControlMaster, label: str) -> None:
    command = [
        str(master.ssh),
        *master.common_arguments,
        "-S",
        "none",
        "-T",
        "--",
        master.destination,
        "sudo -n true",
    ]
    last_returncode = 255
    for attempt in range(1, 7):
        try:
            result = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=None if attempt == 6 else subprocess.DEVNULL,
                check=False,
                timeout=SSH_CONNECT_TIMEOUT + 5,
                env=connector_environment(),
            )
        except (OSError, subprocess.TimeoutExpired):
            result = None
        if result is not None:
            last_returncode = result.returncode
            if result.returncode == 0:
                write_stderr(f"  OK {label}: frische unabhängige SSH-Anmeldung erfolgreich.")
                return
        if attempt < 6:
            time.sleep(2)
    raise UserError(f"{label}: frische SSH-Anmeldung schlug fehl (letzter Exit {last_returncode}).")


def upload_file_via_master(
    master: SSHControlMaster,
    source: Path,
    destination: str,
    label: str,
) -> None:
    display_size = path_size(source, label)
    write_stderr(f"  Sende {label} ({display_size}) …")
    remote_script = f"set -eu; umask 077; cat > {shlex.quote(destination)}; chmod 0600 {shlex.quote(destination)}"
    command = [
        str(master.ssh),
        *master.common_arguments,
        "-S",
        str(master.socket_path),
        "-T",
        "--",
        master.destination,
        remote_script,
    ]
    try:
        with source.open("rb") as stream:
            result = subprocess.run(
                command,
                stdin=stream,
                stdout=subprocess.DEVNULL,
                check=False,
                timeout=1800,
                env=connector_environment(),
            )
    except subprocess.TimeoutExpired as exc:
        raise UserError(f"Upload von {label} überschritt das Zeitlimit.") from exc
    except OSError as exc:
        raise UserError(f"Upload von {label} konnte nicht gestartet werden.") from exc
    if result.returncode != 0:
        raise UserError(f"Upload von {label} schlug fehl (Exit {result.returncode}).")
    write_stderr(f"  OK {label} übertragen.")


def upload_provision_payload(
    master: SSHControlMaster,
    artifacts: ProvisionArtifacts,
    public_key_file: Path,
    remote_stage: str,
    mode: BrowserBuildMode,
) -> None:
    if REMOTE_STAGE_RE.fullmatch(remote_stage) is None:
        raise UserError("Interner Remote-Staging-Pfad ist ungültig.")
    stage = shlex.quote(remote_stage)
    remote_command(
        master,
        f"set -eu; umask 077; test ! -e {stage}; mkdir -m 0700 {stage}",
        label="Remote-Staging",
        timeout=30,
    )
    upload_file_via_master(master, public_key_file, f"{remote_stage}/admin.pub", "SSH-Public-Key")
    upload_file_via_master(master, artifacts.ssh_archive, f"{remote_stage}/ssh.tar.gz", "SSH-/GUI-Artefakt")
    upload_file_via_master(master, artifacts.pbp_archive, f"{remote_stage}/pbp.tar.gz", "PBP-Artefakt")

    write_stderr("  Prüfe SHA-256 und entpacke die Artefakte auf der VM …")
    ssh_digest = shlex.quote(artifacts.ssh_sha256)
    pbp_digest = shlex.quote(artifacts.pbp_sha256)
    package_root = shlex.quote(mode.package_root)
    verify_script = (
        f"set -eu; cd {stage}; "
        f"printf '%s  %s\\n' {ssh_digest} ssh.tar.gz | sha256sum -c -; "
        f"printf '%s  %s\\n' {pbp_digest} pbp.tar.gz | sha256sum -c -; "
        "tar -xzf ssh.tar.gz; tar -xzf pbp.tar.gz; "
        "test -x toolkit-ssh/bootstrap-ssh.sh; "
        f"test -x {package_root}/bootstrap-pbp.sh; "
        "test -f admin.pub; test ! -L admin.pub"
    )
    remote_command(
        master,
        verify_script,
        label="Remote-Artefaktprüfung",
        timeout=300,
    )
    write_stderr("  OK Remote-Artefakte geprüft und entpackt.")


