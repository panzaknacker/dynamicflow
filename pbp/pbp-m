class SignalCoordinator:
    """record termination requests, forward them, and let cleanup finish."""

    def __init__(self) -> None:
        self.received: int | None = None
        self.connector: subprocess.Popen[bytes] | None = None
        self._previous: dict[int, signal.Handlers] = {}

    @staticmethod
    def supported_signals() -> tuple[int, ...]:
        names = ("SIGINT", "SIGTERM", "SIGHUP", "SIGQUIT")
        return tuple(getattr(signal, name) for name in names if hasattr(signal, name))

    def install(self) -> None:
        for signum in self.supported_signals():
            self._previous[signum] = signal.getsignal(signum)
            signal.signal(signum, self._handle)

    def restore(self) -> None:
        for signum, previous in self._previous.items():
            signal.signal(signum, previous)
        self._previous.clear()

    def _handle(self, signum: int, _frame: object) -> None:
        if self.received is None:
            self.received = signum
        connector = self.connector
        if connector is not None and connector.poll() is None:
            try:
                connector.send_signal(signum)
            except OSError:
                pass

    @property
    def exit_code(self) -> int:
        return 128 + (self.received or 0)


class SetupSignalGuard:
    """interrupt work promptly, then defer further signals until cleanup ends."""

    def __init__(self) -> None:
        self.received: int | None = None
        self.cleaning = False
        self._previous: dict[int, signal.Handlers] = {}

    def install(self) -> None:
        for signum in SignalCoordinator.supported_signals():
            self._previous[signum] = signal.getsignal(signum)
            signal.signal(signum, self._handle)

    def begin_cleanup(self) -> None:
        self.cleaning = True

    def restore(self) -> None:
        for signum, previous in self._previous.items():
            signal.signal(signum, previous)
        self._previous.clear()

    def _handle(self, signum: int, _frame: object) -> None:
        if self.received is None:
            self.received = signum
        if not self.cleaning:
            raise SetupInterrupted(signum)


def write_stderr(message: str) -> None:
    try:
        print(message, file=sys.stderr)
    except (OSError, ValueError):
        try:
            try:
                stderr_descriptor = sys.stderr.fileno()
            except (AttributeError, OSError, ValueError):
                stderr_descriptor = 2
            descriptor = os.open(os.devnull, os.O_WRONLY | getattr(os, "O_CLOEXEC", 0))
            if descriptor != stderr_descriptor:
                try:
                    os.dup2(descriptor, stderr_descriptor)
                finally:
                    os.close(descriptor)
        except (OSError, ValueError):
            pass


def progress_step(current: int, total: int, title: str) -> None:
    if current < 1 or total < current:
        raise UserError("Interner Fortschrittszähler ist ungültig.")
    write_stderr(f"\n[{current}/{total}] {title}")


def human_size(byte_count: int) -> str:
    if byte_count < 0:
        raise UserError("Interne Dateigröße ist ungültig.")
    size = float(byte_count)
    units = ("B", "KiB", "MiB", "GiB", "TiB")
    for index, unit in enumerate(units):
        if size < 1024 or index == len(units) - 1:
            if unit == "B":
                return f"{int(size)} {unit}"
            return f"{size:.1f} {unit}"
        size /= 1024
    raise UserError("Interne Größenformatierung schlug fehl.")


def path_size(path: Path, label: str) -> str:
    try:
        return human_size(path.stat().st_size)
    except OSError as exc:
        raise UserError(f"Größe von {label} konnte nicht gelesen werden.") from exc


