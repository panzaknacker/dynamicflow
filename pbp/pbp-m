  WICHTIG
    - Falls noch keine Cloud-Firewall aktiv ist: erstellen, aktivieren und exakt
      dieser VM zuordnen; Provider-Aktivierung abwarten.
    - Jede breitere SSH-Regel entfernen: kein 0.0.0.0/0, kein größeres IPv4-Netz.
    - Keine IPv6-Inbound-Regel (::/0 oder sonstige Quelle) hinzufügen.
    - TCP 5901 niemals öffentlich öffnen; VNC läuft nur durch den SSH-Tunnel.
    - Provider-/Recovery-Konsole offen lassen, bis pbp-m eine frische SSH-Anmeldung
      nach der Härtung bestätigt hat. Der gehaltene Setup-Kanal verhindert Lockout.

pbp-m verändert keine Cloud-API. Nach der Bestätigung verbindet es sich, baut die
lokalen Artefakte, richtet SSH/GUI, Mullvad und PBP ein und prüft alles in einem Lauf.
"""
    write_tty(gate)
    try:
        confirmed = confirm_tty("Cloud-Firewall ist exakt so aktiv und der VM zugeordnet?")
    except UserError:
        manual_unconfirmed_reminder(target, source_cidr, ssh_port)
        raise
    if not confirmed:
        manual_unconfirmed_reminder(target, source_cidr, ssh_port)
        raise UserError("Cloud-Firewall wurde nicht bestätigt.")


def confirm_manual_firewall(
    target: Target,
    source_cidr: str,
    ssh_port: int,
    local_port: int,
) -> None:
    gate = f"""
=== MANUELLER CLOUD-FIREWALL-GATE ===
Zielserver:         {target.host}
SSH-Ziel:           {target.ssh_destination}
Access-IP:          {source_cidr}
SSH-Key:            lokal vorab validiert
Lokaler Tunnelport: 127.0.0.1:{local_port} (vorab frei)

Stelle jetzt providerneutral den FINAL wirksamen Firewall-Zustand her:
  1) Am exakten Zielserver {target.host} müssen alle wirksamen Cloud-Firewalls,
     Security Groups, ACLs und die Host-Firewall identifiziert sein.
  2) Inbound TCP Port {ssh_port} ausschließlich von {source_cidr} erlauben und die
     aktive Zuordnung zum Zielserver abwarten.
  3) Vor der Bestätigung jede breitere SSH-Freigabe in ALLEN wirksamen Ebenen
     entfernen/deaktivieren, insbesondere 0.0.0.0/0, ::/0 oder größere Netze.
  4) TCP 5901 niemals extern freigeben; VNC bleibt ausschließlich im SSH-Tunnel.
  5) Outbound-Regeln für diesen Schritt unverändert lassen und keine neue
     einschränkende Outbound-Regel anlegen.
  6) Die ursprüngliche SSH-Sitzung und eine unabhängige Provider-/Recovery-Konsole offen halten.
     Erst nach erfolgreichem Aufbau dieser frischen pbp-m-Verbindung schließen.

pbp-m ändert im manuellen Modus selbst keine Cloud-Konfiguration.
"""
    write_tty(gate)
    try:
        confirmed = confirm_tty("Ist der finale Firewall-Zustand exakt geprüft?")
    except UserError:
        manual_unconfirmed_reminder(target, source_cidr, ssh_port)
        raise
    if not confirmed:
        manual_unconfirmed_reminder(target, source_cidr, ssh_port)
        raise UserError("Manuelles Firewall-Gate wurde nicht bestätigt.")


def manual_unconfirmed_reminder(target: Target, source_cidr: str, ssh_port: int) -> None:
    message = (
        "\nBEDINGTER FIREWALL-HINWEIS:\n"
        "Falls du bereits Cloud-Regeln geändert hast, prüfe und entferne die "
        f"nicht mehr benötigte /32-Regel TCP {ssh_port} von {source_cidr} am "
        f"exakten Zielserver {target.host} in allen wirksamen Ebenen.\n"
    )
    try:
        write_tty(message)
    except UserError:
        write_stderr(message.rstrip())


def manual_firewall_final_reminder(target: Target, source_cidr: str, ssh_port: int) -> None:
    message = (
        "\nMANUELLE CLOUD-FIREWALL-ABSCHLUSSPRÜFUNG:\n"
        f"Wenn du die VM {target.host} weiter benutzt, muss ALLOW TCP {ssh_port} "
        f"von {source_cidr} auf exakt diese VM bestehen bleiben; darüber laufen "
        "weitere SSH-Verbindungen und der VNC-Tunnel.\n"
        "Entferne nur alte/stale Access-IPs, breite SSH-Regeln und falsche "
        "Firewall-/Security-Group-/ACL-Zuordnungen. TCP 5901 muss extern "
        "geschlossen bleiben.\n"
        "Bei einem Teilfehler die exakte /32-Regel für die Diagnose behalten. "
        "Erst wenn du die VM endgültig verwirfst, auch diese Regel beziehungsweise "
        "ihre VM-Zuordnung entfernen.\n"
        "pbp-m kann manuell gesetzte Cloud-Regeln weder prüfen noch verändern.\n"
    )
    try:
        write_tty(message)
    except UserError:
        write_stderr(message.rstrip())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pbp-m",
        description=(
            "Richtet interaktiv eine neue disposable PBP-VM vollständig ein oder öffnet "
            "den gehärteten GUI-Tunnel zu einer bestehenden VM."
        ),
        epilog=(
            "Optionaler verifizierter Adaptermodus: HELPER wird ohne Shell als "
            "HELPER acquire --host IP --source-cidr CIDR --ssh-port PORT "
            "--ttl-seconds TTL aufgerufen und muss JSON gemäß "
            f"{WHITELIST_SCHEMA} liefern. Nach Tunnelende folgt "
            "HELPER release --lease-id ID."
        ),
    )
    action = parser.add_mutually_exclusive_group()
    action.add_argument(
        "--setup",
        action="store_true",
        help="neue disposable VM interaktiv komplett einrichten",
    )
    action.add_argument(
        "--connect",
        action="store_true",
        help="bestehende VM verbinden (ohne Modusflag weiterhin Standard bei CLI-Argumenten)",
    )
    parser.add_argument("target", nargs="?", help="öffentliche IP oder USER@IP; ohne Wert folgt eine Abfrage")
    parser.add_argument("--ssh-user", default=DEFAULT_SSH_USER, help="Standardbenutzer für HOST")
    parser.add_argument(
        "--source-ip",
        help="Explizite öffentliche Access-Einzel-IP; sonst folgt exakt die Abfrage 'IP für Access:'",
    )
    parser.add_argument("--identity", type=Path, help="Expliziter privater SSH-Key")
    parser.add_argument(
        "--ssh-directory",
        type=Path,
        default=Path("~/.ssh"),
        help="Verzeichnis für die interaktive Key-Suche (Standard: ~/.ssh)",
    )
    parser.add_argument(
        "--known-hosts",
        type=Path,
        help=(
            "bereits unabhängig verifizierte known_hosts-Datei; beim Setup wird sonst "
            "ein eigener pro-VM-Pin unter ~/.ssh/pbp-m-known-hosts angelegt"
        ),
    )
    parser.add_argument("--ssh-port", type=validate_port, default=DEFAULT_SSH_PORT)
    parser.add_argument("--local-port", type=validate_port, default=DEFAULT_LOCAL_PORT)
    parser.add_argument(
        "--whitelist-helper",
        help=(
            "Aktiviert optional den verifizierten Provider-/Control-Plane-Adaptermodus; "
            "alternativ PBP_M_WHITELIST_HELPER"
        ),
    )
    parser.add_argument(
        "--connect-helper",
        help="GUI-Tunnel-Helper; standardmäßig ../ssh/connect-gui.sh",
    )
    parser.add_argument(
        "--whitelist-ttl",
        type=validate_ttl,
        default=DEFAULT_WHITELIST_TTL,
        help="Nur Adaptermodus: providerseitig erzwungene Lease-TTL (Standard: 14400)",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Nur Adaptermodus: einfache Zusammenfassung überspringen; nie das manuelle Gate",
    )
    parser.add_argument(
        "--persona-class",
        choices=PERSONA_CLASSES,
        help="Setup: feste Persona-Klasse für diese Wegwerf-VM",
    )
    parser.add_argument(
        "--hostkey-fingerprint",
        help="Setup: SHA256:... aus einer unabhängigen Provider-/Recovery-Konsole",
    )
    parser.add_argument(
        "--accept-disposable-test-browser",
        action="store_true",
        help="Setup: aktuell markierten TEST-ONLY-Browserbuild ohne zweite Ja/Nein-Abfrage verwenden",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="Setup abschließen, aber anschließend keinen GUI-Tunnel offen halten",
    )
    return parser


def run_connect(arguments: argparse.Namespace) -> int:
    if not SSH_USER_RE.fullmatch(arguments.ssh_user) or arguments.ssh_user == "root":
        raise UserError("--ssh-user ist ungültig; Root-Login ist nicht erlaubt.")
    if (
        arguments.persona_class is not None
        or arguments.hostkey_fingerprint is not None
        or arguments.accept_disposable_test_browser
        or arguments.no_open
    ):
        raise UserError(
            "--persona-class, --hostkey-fingerprint, --accept-disposable-test-browser "
            "und --no-open gelten nur mit --setup."
        )

    raw_target = arguments.target or prompt("PBP-Ziel (öffentliche IP oder USER@IP): ")
    target = normalize_target(raw_target, arguments.ssh_user)
    progress_step(1, 2, "SSH-Vertrauen und Cloud-Firewall prüfen")
    known_hosts_value = arguments.known_hosts
    if known_hosts_value is None:
        ssh_root = absolute_user_path(arguments.ssh_directory)
        managed_candidate = (
            ssh_root / "pbp-m-known-hosts" / f"{target.host.replace('.', '_')}-{arguments.ssh_port}.known_hosts"
        )
        known_hosts_value = (
            managed_candidate
            if managed_candidate.exists() or managed_candidate.is_symlink()
            else Path("~/.ssh/known_hosts")
        )
    known_hosts = validate_known_hosts(known_hosts_value)
    verify_known_host_pin(known_hosts, target, arguments.ssh_port)

    identity = (
        validate_private_key(arguments.identity) if arguments.identity else choose_private_key(arguments.ssh_directory)
    )

    script_directory = Path(__file__).resolve().parent
    connect_value = arguments.connect_helper or os.environ.get("PBP_M_CONNECT_HELPER")
    connect_helper = resolve_executable(
        connect_value,
        name="connect-gui.sh",
        fallback=script_directory.parent / "ssh" / "connect-gui.sh",
    )
    verify_local_port_available(arguments.local_port)

    whitelist_value = arguments.whitelist_helper or os.environ.get("PBP_M_WHITELIST_HELPER")
    whitelist_helper = resolve_executable(whitelist_value, name="pbp-m-whitelist") if whitelist_value else None
    if whitelist_helper is None:
        if arguments.yes:
            raise UserError(
                "--yes ist im manuellen Firewall-Modus verboten; "
                "dieses Gate verlangt eine direkte y/N-Bestätigung am Terminal."
            )
        verify_controlling_tty()

    source_cidr = normalize_source_ip(arguments.source_ip) if arguments.source_ip else prompt_source_ip()
    verify_matching_ip_family(target, source_cidr)

    connector_command = [
        str(connect_helper),
        "--identity",
        str(identity),
        "--known-hosts",
        str(known_hosts),
        "--ssh-port",
        str(arguments.ssh_port),
        "--local-port",
        str(arguments.local_port),
        target.ssh_destination,
    ]

    if whitelist_helper is None:
        confirm_manual_firewall(
            target,
            source_cidr,
            arguments.ssh_port,
            arguments.local_port,
        )
        coordinator = SignalCoordinator()
        coordinator.install()
        try:
            if coordinator.received is None:
                progress_step(2, 2, "Gehärteten SSH-/VNC-Tunnel öffnen")
                connector_returncode = run_connector(connector_command, coordinator)
            else:
                connector_returncode = coordinator.exit_code
        finally:
            try:
                coordinator.restore()
            finally:
                manual_firewall_final_reminder(target, source_cidr, arguments.ssh_port)
        if coordinator.received is not None:
            return coordinator.exit_code
        return connector_returncode

    if not arguments.yes:
        confirm_helper_lease(target, source_cidr, identity, arguments.whitelist_ttl)

    coordinator = SignalCoordinator()
    connector_returncode = 1
    release_ok = True
    lease: Lease | None = None
    coordinator.install()
    try:
        progress_step(2, 2, "Temporäre SSH-Allowlist setzen und GUI-Tunnel öffnen")
        write_stderr("  Setze temporäre SSH-Allowlist …")
        try:
            lease = acquire_lease(
                whitelist_helper,
                host=target.host,
                source_cidr=source_cidr,
                ssh_port=arguments.ssh_port,
                ttl=arguments.whitelist_ttl,
            )
        except UserError:
            if coordinator.received is not None:
                return coordinator.exit_code
            raise

        if coordinator.received is None:
            write_stderr("  OK Allowlist bestätigt; öffne den gehärteten GUI-Tunnel.")
            connector_returncode = run_connector(connector_command, coordinator)
        else:
            connector_returncode = coordinator.exit_code
    finally:
        try:
            if lease is not None:
                write_stderr("Entferne temporäre SSH-Allowlist …")
                release_ok = release_lease(whitelist_helper, lease)
        finally:
            coordinator.restore()

    if not release_ok:
        write_stderr(
            "FEHLER: Allowlist-Lease konnte nicht aktiv entfernt werden. "
            "Er muss spätestens durch die providerseitige TTL auslaufen."
        )
        return 1
    if coordinator.received is not None:
        return coordinator.exit_code
    return connector_returncode


def run_setup(arguments: argparse.Namespace) -> int:
    if not SSH_USER_RE.fullmatch(arguments.ssh_user) or arguments.ssh_user == "root":
        raise UserError("--ssh-user ist ungültig; Root-Login ist nicht erlaubt.")
    if arguments.yes:
        raise UserError("--yes ist beim Einrichten einer neuen VM nicht zulässig.")
    if arguments.whitelist_helper:
        raise UserError(
            "Der neue VM-Setup nutzt absichtlich die einmal bestätigte manuelle "
            "providerneutrale Cloud-Firewall, keinen Provider-Adapter."
        )
    if (
        arguments.hostkey_fingerprint is not None
        and HOSTKEY_FINGERPRINT_RE.fullmatch(arguments.hostkey_fingerprint) is None
    ):
        raise UserError("--hostkey-fingerprint muss exakt das Format SHA256:... haben.")
    if arguments.known_hosts is not None and arguments.hostkey_fingerprint is not None:
        raise UserError("--known-hosts und --hostkey-fingerprint dürfen beim Setup nicht kombiniert werden.")

    verify_controlling_tty()
    write_stderr("\n=== NEUE PBP-VM EINRICHTEN ===")
    raw_target = arguments.target or prompt("Neue VM (öffentliche IP oder USER@IP): ")
    target = normalize_target(raw_target, arguments.ssh_user)
    identity = (
        validate_private_key(arguments.identity) if arguments.identity else choose_private_key(arguments.ssh_directory)
    )
    public_key = derive_public_key(identity)
    source_cidr = normalize_source_ip(arguments.source_ip) if arguments.source_ip else prompt_source_ip()
    verify_matching_ip_family(target, source_cidr)
    persona = choose_persona_class(arguments.persona_class)
    if not arguments.no_open:
        verify_local_port_available(arguments.local_port)

    explicit_known_hosts: Path | None = None
    if arguments.known_hosts is not None:
        explicit_known_hosts = validate_known_hosts(arguments.known_hosts)
        verify_known_host_pin(explicit_known_hosts, target, arguments.ssh_port)

    script_directory = Path(__file__).resolve().parent
    connect_helper: Path | None = None
    if not arguments.no_open:
        connect_value = arguments.connect_helper or os.environ.get("PBP_M_CONNECT_HELPER")
        connect_helper = resolve_executable(
            connect_value,
            name="connect-gui.sh",
            fallback=script_directory.parent / "ssh" / "connect-gui.sh",
        )

    mode = choose_browser_build_mode(
        script_directory,
        accept_disposable_test=arguments.accept_disposable_test_browser,
    )
    confirm_setup_firewall(
        target,
        source_cidr,
        arguments.ssh_port,
        identity,
        persona,
        mode,
    )

    firewall_confirmed = True
    setup_signals = SetupSignalGuard()
    setup_signals.install()
    master: SSHControlMaster | None = None
    remote_stage = f"/tmp/dynamicflow-pbp-{secrets.token_hex(12)}"
    stage_cleaned = False
    try:
        progress_step(1, 6, "SSH-Vertrauen und VM prüfen")
        known_hosts = ensure_setup_host_pin(
            target,
            arguments.ssh_port,
            arguments.ssh_directory,
            explicit_known_hosts,
            arguments.hostkey_fingerprint,
        )
        master = start_ssh_control_master(
            target,
            arguments.ssh_port,
            identity,
            known_hosts,
        )
        architecture = remote_preflight(master)

        with tempfile.TemporaryDirectory(prefix="pbp-m-build-") as build_name:
            build_root = Path(build_name)
            public_key_file = build_root / "admin.pub"
            descriptor = os.open(
                public_key_file,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
            try:
                write_descriptor(descriptor, f"{public_key}\n".encode("ascii"))
                os.fsync(descriptor)
            finally:
                os.close(descriptor)

            progress_step(2, 6, "Lokale Installationsartefakte bauen")
            artifacts = build_provision_artifacts(
                script_directory,
                architecture,
                mode,
                build_root,
            )
            progress_step(3, 6, "Artefakte sicher zur VM übertragen")
            upload_provision_payload(
                master,
                artifacts,
                public_key_file,
                remote_stage,
                mode,
            )
            progress_step(4, 6, "SSH und loopback-only GUI einrichten")
            install_remote_pbp(
                master,
                remote_stage,
                target,
                persona,
                mode,
            )
            progress_step(6, 6, "Abschlusszustand prüfen")
            vnc_password = verify_remote_pbp(master, persona)
            write_stderr("  OK Browser, Mullvad, Kill-Switch und VNC sind betriebsbereit.")

        cleanup_remote_stage(master, remote_stage)
        stage_cleaned = True
        stop_ssh_control_master(master)
        master = None

        build_label = "DISPOSABLE TEST-ONLY" if mode.disposable_test else "security release"
        write_tty(
            "\n=== PBP-VM BEREIT ===\n"
            f"VM:             {target.ssh_destination}\n"
            f"Persona:        {persona}\n"
            f"Browser-Build:  {build_label}\n"
            f"GUI-Tunnel:     127.0.0.1:{arguments.local_port} -> VM 127.0.0.1:5901\n"
            "Der private SSH-Key wurde nicht hochgeladen.\n\n"
        )
        write_setup_vnc_access(vnc_password, arguments.local_port)

        if arguments.no_open:
            write_tty(
                "Der GUI-Tunnel wurde wegen --no-open nicht gestartet. Später mit ./pbp-m --connect zur VM verbinden.\n"
            )
            return 0

        assert connect_helper is not None
        connector_command = [
            str(connect_helper),
            "--identity",
            str(identity),
            "--known-hosts",
            str(known_hosts),
            "--ssh-port",
            str(arguments.ssh_port),
            "--local-port",
            str(arguments.local_port),
            target.ssh_destination,
        ]
        coordinator = SignalCoordinator()
        coordinator.install()
        try:
            write_stderr("Setup erfolgreich; öffne jetzt den gehärteten GUI-Tunnel.")
            connector_returncode = run_connector(connector_command, coordinator)
        finally:
            coordinator.restore()
        if coordinator.received is not None:
            return coordinator.exit_code
        return connector_returncode
    finally:
        setup_signals.begin_cleanup()
        try:
            if master is not None:
                stop_ssh_control_master(master)
            if not stage_cleaned:
                write_stderr(
                    f"HINWEIS: Bei einem Teilfehler kann Debug-Staging auf der Wegwerf-VM verbleiben: {remote_stage}"
                )
            if firewall_confirmed:
                manual_firewall_final_reminder(target, source_cidr, arguments.ssh_port)
        finally:
            setup_signals.restore()


def main(argv: Sequence[str] | None = None) -> int:
    raw_arguments = list(sys.argv[1:] if argv is None else argv)
    if not raw_arguments:
        selected = choose_number(
            "PBP - sicherer Browserzugang:",
            (
                "Neue disposable PBP-VM komplett einrichten",
                "Vorhandene PBP-VM verbinden",
            ),
        )
        raw_arguments = ["--setup" if selected == 0 else "--connect"]
    arguments = build_parser().parse_args(raw_arguments)
    if arguments.setup:
        return run_setup(arguments)
    return run_connect(arguments)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except UserError as error:
        fail(str(error))
    except SetupInterrupted as error:
        fail(str(error), 128 + error.signum)
    except KeyboardInterrupt:
        fail("Einrichtung wurde am Terminal abgebrochen.", 130)
