def run_connector(command: Sequence[str], coordinator: SignalCoordinator) -> int:
    try:
        process = subprocess.Popen(command, env=connector_environment())
    except OSError as exc:
        write_stderr(f"FEHLER: GUI-Tunnel-Helper konnte nicht gestartet werden: {exc}")
        return 1

    coordinator.connector = process
    signal_deadline: float | None = None
    try:
        while True:
            returncode = process.poll()
            if returncode is not None:
                if coordinator.received is not None:
                    return coordinator.exit_code
                return 128 - returncode if returncode < 0 else returncode

            if coordinator.received is not None:
                if signal_deadline is None:
                    try:
                        process.send_signal(coordinator.received)
                    except OSError:
                        pass
                    signal_deadline = time.monotonic() + CONNECTOR_SIGNAL_GRACE
                elif time.monotonic() >= signal_deadline:
                    try:
                        process.terminate()
                        process.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
                    except OSError:
                        pass
                    return coordinator.exit_code
            time.sleep(0.1)
    finally:
        coordinator.connector = None


