def choose_number(title: str, values: Sequence[str]) -> int:
    if not values:
        raise UserError("Interaktive Auswahl enthält keine Werte.")
    print(title)
    for index, value in enumerate(values, start=1):
        print(f"  {index}) {value}")
    while True:
        answer = prompt("Auswahl [1]: ").strip() or "1"
        if answer.isdigit():
            selected = int(answer, 10)
            if 1 <= selected <= len(values):
                return selected - 1
        print("Bitte eine aufgeführte Nummer wählen.", file=sys.stderr)


def choose_persona_class(explicit: str | None) -> str:
    if explicit:
        if explicit not in PERSONA_CLASSES:
            raise UserError("Persona muss basic, performance oder workstation sein.")
        return explicit
    selected = choose_number("Persona für diese disposable VM:", PERSONA_DESCRIPTIONS)
    return PERSONA_CLASSES[selected]


def confirm_tty(message: str, *, default_yes: bool = False) -> bool:
    suffix = "[Y/n]: " if default_yes else "[y/N]: "
    answer = prompt_tty(f"{message} {suffix}").strip().lower()
    if not answer:
        return default_yes
    return answer in {"j", "ja", "y", "yes"}


def ensure_private_directory(path: Path) -> Path:
    expanded = absolute_user_path(path)
    validate_path_ancestors(expanded)
    try:
        os.mkdir(expanded, 0o700)
    except FileExistsError:
        pass
    except OSError as exc:
        raise UserError(f"Privates Verzeichnis kann nicht angelegt werden: {expanded}") from exc
    try:
        metadata = expanded.lstat()
    except OSError as exc:
        raise UserError(f"Privates Verzeichnis kann nicht geprüft werden: {expanded}") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o077
    ):
        raise UserError(f"Privates Verzeichnis hat unsichere Metadaten: {expanded}")
    return expanded


def hash_file(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as stream:
            while chunk := stream.read(1024 * 1024):
                digest.update(chunk)
    except OSError as exc:
        raise UserError(f"Artefakt kann nicht gehasht werden: {path}") from exc
    return digest.hexdigest()


def validate_local_artifact(path: Path, label: str) -> tuple[Path, str]:
    try:
        expanded = path.resolve(strict=True)
        metadata = expanded.stat()
    except OSError as exc:
        raise UserError(f"{label} fehlt nach dem lokalen Build: {path}") from exc
    validate_path_ancestors(expanded)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o022
        or not 1 <= metadata.st_size <= MAX_ARCHIVE_SIZE
    ):
        raise UserError(f"{label} hat unsichere Metadaten oder Größe: {expanded}")
    return expanded, hash_file(expanded)


def derive_public_key(identity: Path) -> str:
    ssh_keygen = resolve_executable(None, name="ssh-keygen", fallback=Path("/usr/bin/ssh-keygen"))
    public_path = Path(str(identity) + ".pub")
    if public_path.exists():
        public_metadata, _ = secure_open_regular(public_path, private=False)
        if public_metadata.st_size > 16_384:
            raise UserError(f"SSH-Public-Key ist unerwartet groß: {public_path}")
        try:
            line = public_path.read_text(encoding="ascii").strip()
        except (OSError, UnicodeError) as exc:
            raise UserError(f"SSH-Public-Key kann nicht gelesen werden: {public_path}") from exc
        try:
            private_fingerprint = subprocess.run(
                [str(ssh_keygen), "-lf", str(identity), "-E", "sha256"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                check=False,
                timeout=10,
                env=connector_environment(),
            )
            public_fingerprint = subprocess.run(
                [str(ssh_keygen), "-lf", str(public_path), "-E", "sha256"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                check=False,
                timeout=10,
                env=connector_environment(),
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise UserError("SSH-Key-Paar konnte nicht geprüft werden.") from exc
        if (
            private_fingerprint.returncode != 0
            or public_fingerprint.returncode != 0
            or private_fingerprint.stdout.split()[1:2] != public_fingerprint.stdout.split()[1:2]
        ):
            raise UserError(f"Public Key passt nicht zum gewählten privaten Key: {public_path}")
    else:
        try:
            result = subprocess.run(
                [str(ssh_keygen), "-y", "-f", str(identity)],
                stdout=subprocess.PIPE,
                stderr=None,
                check=False,
                timeout=120,
                env=connector_environment(),
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise UserError("Public Key konnte nicht aus dem privaten Key abgeleitet werden.") from exc
        if result.returncode != 0:
            raise UserError("Public Key konnte nicht aus dem privaten Key abgeleitet werden.")
        try:
            line = result.stdout.decode("ascii", errors="strict").strip()
        except UnicodeError as exc:
            raise UserError("Abgeleiteter Public Key ist nicht gültiges ASCII.") from exc
    fields = line.split()
    if len(fields) < 2 or fields[0] not in {"ssh-ed25519", "ecdsa-sha2-nistp256", "ssh-rsa"}:
        raise UserError("Gewählter SSH-Key hat keinen unterstützten Public-Key-Typ.")
    try:
        decoded = base64.b64decode(fields[1], validate=True)
    except (ValueError, binascii.Error) as exc:
        raise UserError("Abgeleiteter Public Key enthält ungültiges Base64.") from exc
    if len(decoded) < 32 or len(fields[1]) > 16_384:
        raise UserError("Abgeleiteter Public Key hat eine ungültige Größe.")
    return f"{fields[0]} {fields[1]}"


def absolute_user_path(path: Path) -> Path:
    return Path(os.path.abspath(os.path.expanduser(str(path))))


def validate_path_ancestors(path: Path) -> None:
    """reject redirectable components while allowing root's sticky /tmp."""

    current = path.parent
    while True:
        try:
            metadata = current.lstat()
        except OSError as exc:
            raise UserError(f"Übergeordnetes Verzeichnis kann nicht geprüft werden: {current}") from exc
        if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
            raise UserError(f"Unsicheres übergeordnetes Verzeichnis: {current}")
        if metadata.st_uid not in {0, os.getuid()}:
            raise UserError(f"Übergeordnetes Verzeichnis hat einen fremden Besitzer: {current}")
        writable = bool(metadata.st_mode & 0o022)
        trusted_sticky = metadata.st_uid == 0 and bool(metadata.st_mode & stat.S_ISVTX)
        if writable and not trusted_sticky:
            raise UserError(f"Übergeordnetes Verzeichnis ist gruppen-/weltbeschreibbar: {current}")
        if current == current.parent:
            break
        current = current.parent


def secure_open_regular(path: Path, *, private: bool) -> tuple[os.stat_result, bytes]:
    validate_path_ancestors(path)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise UserError(f"Datei kann nicht sicher geöffnet werden: {path}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise UserError(f"Datei ist keine reguläre Datei: {path}")
        if metadata.st_uid != os.getuid():
            raise UserError(f"Datei gehört nicht dem aktuellen Benutzer: {path}")
        forbidden_mode = 0o077 if private else 0o022
        if metadata.st_mode & forbidden_mode:
            detail = "Gruppen-/Fremdzugriff" if private else "Gruppen-/Fremdschreibzugriff"
            raise UserError(f"Datei hat unsicheren {detail}: {path}")
        return metadata, os.read(descriptor, 512)
    finally:
        os.close(descriptor)


def validate_private_key(path: Path) -> Path:
    expanded = absolute_user_path(path)
    if not SSH_PATH_RE.fullmatch(str(expanded)):
        raise UserError(
            "Privater SSH-Key-Pfad enthält Zeichen, die OpenSSH umdeuten könnte; "
            "verwende einen absoluten Pfad ohne Leerraum, %, $, Quotes oder Backslash."
        )
    _, header = secure_open_regular(expanded, private=True)
    first_line = header.splitlines()[0] if header else b""
    if first_line not in PRIVATE_KEY_HEADERS:
        raise UserError(f"Datei sieht nicht wie ein unterstützter OpenSSH-/PEM-Privatschlüssel aus: {expanded}")
    ssh_keygen = resolve_executable(None, name="ssh-keygen", fallback=Path("/usr/bin/ssh-keygen"))
    try:
        result = subprocess.run(
            [str(ssh_keygen), "-l", "-f", str(expanded)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=10,
            env=connector_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UserError(f"Privater SSH-Key konnte nicht sicher validiert werden: {expanded}") from exc
    if result.returncode != 0:
        raise UserError(f"Privater SSH-Key ist strukturell ungültig: {expanded}")
    return expanded


def validate_known_hosts(path: Path) -> Path:
    expanded = absolute_user_path(path)
    if not SSH_PATH_RE.fullmatch(str(expanded)):
        raise UserError(
            "known_hosts-Pfad enthält Zeichen, die OpenSSH umdeuten könnte; "
            "verwende einen absoluten Pfad ohne Leerraum, %, $, Quotes oder Backslash."
        )
    metadata, _ = secure_open_regular(expanded, private=False)
    if metadata.st_size > MAX_KNOWN_HOSTS_SIZE:
        raise UserError("known_hosts überschreitet das feste 1-MiB-Prüflimit.")
    return expanded


def discover_private_keys(ssh_directory: Path) -> list[Path]:
    root = absolute_user_path(ssh_directory)
    try:
        root_metadata = root.lstat()
    except OSError:
        return []
    if (
        not stat.S_ISDIR(root_metadata.st_mode)
        or stat.S_ISLNK(root_metadata.st_mode)
        or root_metadata.st_uid != os.getuid()
        or root_metadata.st_mode & 0o022
    ):
        return []

    candidates: list[Path] = []
    for current_root, directories, filenames in os.walk(root, topdown=True, followlinks=False):
        current = Path(current_root)
        relative_depth = len(current.relative_to(root).parts)
        if relative_depth >= 3:
            directories[:] = []
        else:
            safe_directories: list[str] = []
            for directory in directories:
                candidate = current / directory
                try:
                    metadata = candidate.lstat()
                except OSError:
                    continue
                if (
                    stat.S_ISDIR(metadata.st_mode)
                    and not stat.S_ISLNK(metadata.st_mode)
                    and metadata.st_uid == os.getuid()
                    and not metadata.st_mode & 0o022
                ):
                    safe_directories.append(directory)
            directories[:] = safe_directories

        for filename in filenames:
            if filename.endswith(".pub") or filename in {
                "authorized_keys",
                "config",
                "known_hosts",
                "known_hosts.old",
            }:
                continue
            candidate = current / filename
            try:
                candidates.append(validate_private_key(candidate))
            except UserError:
                continue
    return sorted(set(candidates), key=lambda path: str(path))


def choose_private_key(ssh_directory: Path) -> Path:
    root = absolute_user_path(ssh_directory)
    keys = discover_private_keys(ssh_directory)
    if not keys:
        raise UserError(
            f"Keine sichere private SSH-Key-Datei unter {ssh_directory.expanduser()} gefunden. "
            "Mit --identity kann eine Datei explizit angegeben werden."
        )
    selected = choose_number(
        "Verfügbare private SSH-Schlüssel:",
        [str(path.relative_to(root)) for path in keys],
    )
    return keys[selected]


def prompt_source_ip() -> str:
    while True:
        try:
            return normalize_source_ip(prompt_tty("IP für Access: "))
        except UserError as exc:
            if "/dev/tty" in str(exc) or "Terminal-Eingabe" in str(exc):
                raise
            write_tty(f"FEHLER: {exc}\n")


def verify_matching_ip_family(target: Target, source_cidr: str) -> None:
    target_address = ipaddress.ip_address(target.host)
    source_address = ipaddress.ip_interface(source_cidr).ip
    if target_address.version != 4 or source_address.version != 4:
        raise UserError("PBP deaktiviert IPv6 systemweit; Ziel und Access-IP müssen öffentliche IPv4-Adressen sein.")


def verify_local_port_available(local_port: int) -> None:
    """catch a local tunnel-port collision before any manual cloud change."""

    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.set_inheritable(False)
        probe.bind(("127.0.0.1", local_port))
    except OSError as exc:
        raise UserError(
            f"Lokaler Tunnel-Port 127.0.0.1:{local_port} ist bereits belegt; "
            "die Cloud-Firewall wurde noch nicht zur Bestätigung freigegeben."
        ) from exc
    finally:
        probe.close()


def resolve_executable(value: str | None, *, name: str, fallback: Path | None = None) -> Path:
    candidate: str | None = value
    if not candidate and fallback and fallback.is_file():
        candidate = str(fallback)
    if not candidate:
        candidate = shutil.which(name)
    elif "/" not in candidate:
        candidate = shutil.which(candidate)
    if not candidate:
        raise UserError(f"Benötigtes Programm nicht gefunden: {name}")
    try:
        path = Path(candidate).expanduser().resolve(strict=True)
        metadata = path.stat()
    except OSError as exc:
        raise UserError(f"Programm kann nicht geprüft werden: {candidate}") from exc
    validate_path_ancestors(path)
    if not stat.S_ISREG(metadata.st_mode) or not os.access(path, os.X_OK):
        raise UserError(f"Programm ist keine ausführbare reguläre Datei: {path}")
    if metadata.st_uid not in {0, os.getuid()} or metadata.st_mode & 0o022:
        raise UserError(f"Programm ist nicht vertrauenswürdig besessen oder beschreibbar: {path}")
    return path


def verify_known_host_pin(known_hosts: Path, target: Target, ssh_port: int) -> None:
    ssh_keygen = resolve_executable(None, name="ssh-keygen", fallback=Path("/usr/bin/ssh-keygen"))
    lookup = target.host if ssh_port == 22 else f"[{target.host}]:{ssh_port}"
    try:
        result = subprocess.run(
            [str(ssh_keygen), "-F", lookup, "-f", str(known_hosts)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=10,
            env=connector_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UserError("Der lokale known_hosts-Pin konnte nicht geprüft werden.") from exc
    if result.returncode != 0:
        raise UserError(
            f"Für {lookup} fehlt ein unabhängig verifizierter Host-Key in {known_hosts}; "
            "die Firewall bleibt geschlossen."
        )
    try:
        lines = result.stdout.decode("utf-8", errors="strict").splitlines()
    except UnicodeError as exc:
        raise UserError("Der known_hosts-Treffer ist nicht sicher als UTF-8 prüfbar.") from exc

    exact_match = False
    unsafe_match = False
    key_record_count = 0
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        key_record_count += 1
        fields = stripped.split()
        if not fields:
            continue
        if fields[0].startswith("@"):
            unsafe_match = True
            continue
        if len(fields) < 3:
            unsafe_match = True
            continue
        hosts = fields[0]
        if hosts.startswith("|1|"):
            # ssh-keygen -f already verified that this salted hash is an exact
            # match for lookup; the entry has no marker and one host hash.
            if hosts.count("|") == 3 and "," not in hosts:
                exact_match = True
            else:
                unsafe_match = True
        elif hosts == lookup:
            exact_match = True
        else:
            # wildcards, negation and comma lists must never become the pin
            # which authorizes a manual cloud-firewall change.
            unsafe_match = True

    if unsafe_match or not exact_match or key_record_count != 1:
        raise UserError(
            f"known_hosts für {lookup} muss genau einen exakten, unmarkierten "
            "Literal-/Hash-Key enthalten; mehrere Keys, Wildcards, Hostlisten, "
            "@cert-authority und @revoked sind verboten."
        )


def known_host_lookup(target: Target, ssh_port: int) -> str:
    return target.host if ssh_port == 22 else f"[{target.host}]:{ssh_port}"


def scan_ed25519_host_key(target: Target, ssh_port: int) -> tuple[str, str]:
    ssh_keyscan = resolve_executable(None, name="ssh-keyscan", fallback=Path("/usr/bin/ssh-keyscan"))
    try:
        result = subprocess.run(
            [
                str(ssh_keyscan),
                "-T",
                str(HOSTKEY_SCAN_TIMEOUT),
                "-p",
                str(ssh_port),
                "-t",
                "ed25519",
                target.host,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=HOSTKEY_SCAN_TIMEOUT + 3,
            env=connector_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UserError("SSH-Host-Key-Kandidat konnte nicht von der neuen VM gelesen werden.") from exc
    if result.returncode != 0 or len(result.stdout) > 65_536:
        raise UserError("SSH-Host-Key-Kandidat konnte nicht von der neuen VM gelesen werden.")
    try:
        raw_lines = result.stdout.decode("ascii", errors="strict").splitlines()
    except UnicodeError as exc:
        raise UserError("SSH-Host-Key-Kandidat ist kein gültiges ASCII.") from exc

    candidates: set[str] = set()
    for raw_line in raw_lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) != 3 or fields[1] != "ssh-ed25519":
            raise UserError("ssh-keyscan lieferte einen unerwarteten Host-Key-Datensatz.")
        try:
            decoded = base64.b64decode(fields[2], validate=True)
        except (ValueError, binascii.Error) as exc:
            raise UserError("SSH-Host-Key-Kandidat enthält ungültiges Base64.") from exc
        if len(decoded) < 32 or len(fields[2]) > 16_384:
            raise UserError("SSH-Host-Key-Kandidat hat eine ungültige Größe.")
        candidates.add(f"ssh-ed25519 {fields[2]}")
    if len(candidates) != 1:
        raise UserError("Die neue VM lieferte nicht genau einen eindeutigen Ed25519-Host-Key.")
    public_key = next(iter(candidates))
    blob = base64.b64decode(public_key.split()[1], validate=True)
    fingerprint = "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii").rstrip("=")
    if HOSTKEY_FINGERPRINT_RE.fullmatch(fingerprint) is None:
        raise UserError("Berechneter SSH-Host-Key-Fingerprint ist ungültig.")
    return public_key, fingerprint


def managed_known_hosts_path(ssh_directory: Path, target: Target, ssh_port: int) -> Path:
    root = absolute_user_path(ssh_directory)
    try:
        metadata = root.lstat()
    except OSError as exc:
        raise UserError(f"SSH-Verzeichnis kann nicht geprüft werden: {root}") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o022
    ):
        raise UserError(f"SSH-Verzeichnis hat unsichere Metadaten: {root}")
    pin_root = ensure_private_directory(root / "pbp-m-known-hosts")
    filename = f"{target.host.replace('.', '_')}-{ssh_port}.known_hosts"
    return pin_root / filename


def atomic_write_known_host(path: Path, target: Target, ssh_port: int, public_key: str) -> Path:
    lookup = known_host_lookup(target, ssh_port)
    payload = f"{lookup} {public_key}\n".encode("ascii")
    temporary = path.parent / f".{path.name}.{secrets.token_hex(8)}"
    descriptor: int | None = None
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        write_descriptor(descriptor, payload)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        if path.exists() or path.is_symlink():
            validate_known_hosts(path)
        os.replace(temporary, path)
        directory_descriptor = os.open(
            path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0),
        )
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    except (OSError, UnicodeError) as exc:
        raise UserError(f"Verifizierter Host-Key-Pin konnte nicht gespeichert werden: {path}") from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
    validated = validate_known_hosts(path)
    verify_known_host_pin(validated, target, ssh_port)
    return validated


def managed_pin_matches(path: Path, target: Target, ssh_port: int, public_key: str) -> bool:
    try:
        validated = validate_known_hosts(path)
        verify_known_host_pin(validated, target, ssh_port)
        content = path.read_text(encoding="ascii")
    except (UserError, OSError, UnicodeError):
        return False
    return content == f"{known_host_lookup(target, ssh_port)} {public_key}\n"


def ensure_setup_host_pin(
    target: Target,
    ssh_port: int,
    ssh_directory: Path,
    explicit_known_hosts: Path | None,
    expected_fingerprint: str | None,
) -> Path:
    if explicit_known_hosts is not None:
        if expected_fingerprint is not None:
            raise UserError(
                "--known-hosts und --hostkey-fingerprint sind zwei alternative "
                "Vertrauensanker und dürfen beim Setup nicht kombiniert werden."
            )
        known_hosts = validate_known_hosts(explicit_known_hosts)
        verify_known_host_pin(known_hosts, target, ssh_port)
        return known_hosts

    public_key, observed_fingerprint = scan_ed25519_host_key(target, ssh_port)
    if expected_fingerprint is not None:
        if HOSTKEY_FINGERPRINT_RE.fullmatch(expected_fingerprint) is None:
            raise UserError("Host-Key-Fingerprint muss exakt das Format SHA256:... haben.")
        if not hmac.compare_digest(expected_fingerprint, observed_fingerprint):
            raise UserError("Host-Key-Fingerprint stimmt nicht mit der neuen VM überein; SSH bleibt geschlossen.")
    pin_path = managed_known_hosts_path(ssh_directory, target, ssh_port)
    if pin_path.exists() and managed_pin_matches(pin_path, target, ssh_port, public_key):
        write_stderr(f"Bereits verifizierter Host-Key-Pin wird wiederverwendet: {observed_fingerprint}")
        return validate_known_hosts(pin_path)

    write_tty(f"\n=== SSH-HOST-KEY DER NEUEN VM ===\nVon der SSH-Verbindung beobachtet: {observed_fingerprint}\n")
    if expected_fingerprint is None and not confirm_tty(
        "Fingerprint über die unabhängige Provider-/Recovery-Konsole prüfen?",
        default_yes=True,
    ):
        write_tty(
            "\nWARNUNG: Host-Key nicht unabhängig verifiziert. Der von ssh-keyscan "
            "beobachtete Schlüssel wird nur als TOFU-Pin gespeichert. Ein Angreifer "
            "beim ersten Kontakt kann damit nicht ausgeschlossen werden.\n"
        )
        return atomic_write_known_host(pin_path, target, ssh_port, public_key)

    instructions = """
Öffne jetzt die unabhängige Provider-/Recovery-Konsole dieser VM und führe dort aus:
  sudo ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256

Kopiere ausschließlich den dort angezeigten SHA256:...-Fingerprint hierher.
ssh-keyscan allein wird nicht als Vertrauensanker verwendet.
"""
    write_tty(instructions)
    expected = expected_fingerprint or prompt_tty("Fingerprint aus Providerkonsole: ").strip()
    if HOSTKEY_FINGERPRINT_RE.fullmatch(expected) is None:
        raise UserError("Host-Key-Fingerprint muss exakt das Format SHA256:... haben.")
    if not hmac.compare_digest(expected, observed_fingerprint):
        raise UserError("Host-Key-Fingerprint stimmt nicht mit der neuen VM überein; SSH bleibt geschlossen.")
    return atomic_write_known_host(pin_path, target, ssh_port, public_key)


def parse_lease(raw: bytes, expected: Lease) -> Lease:
    if not raw or len(raw) > MAX_HELPER_OUTPUT:
        raise UserError("Allowlist-Adapter lieferte keine gültige begrenzte Antwort.")
    try:
        document = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise UserError("Allowlist-Adapter lieferte kein gültiges JSON.") from exc
    if not isinstance(document, dict) or set(document) != {
        "schema",
        "lease_id",
        "host",
        "source_cidr",
        "ssh_port",
    }:
        raise UserError("Allowlist-Adapter lieferte nicht das erwartete Lease-Schema.")
    if (
        not isinstance(document.get("schema"), str)
        or not isinstance(document.get("lease_id"), str)
        or not isinstance(document.get("host"), str)
        or not isinstance(document.get("source_cidr"), str)
        or not isinstance(document.get("ssh_port"), int)
        or isinstance(document.get("ssh_port"), bool)
    ):
        raise UserError("Allowlist-Adapter lieferte ungültige Feldtypen.")
    received = Lease(
        lease_id=document["lease_id"],
        host=document["host"],
        source_cidr=document["source_cidr"],
        ssh_port=document["ssh_port"],
    )
    if document.get("schema") != WHITELIST_SCHEMA or not LEASE_ID_RE.fullmatch(received.lease_id):
        raise UserError("Allowlist-Adapter lieferte eine ungültige Schema- oder Lease-ID.")
    if (
        received.host != expected.host
        or received.source_cidr != expected.source_cidr
        or received.ssh_port != expected.ssh_port
    ):
        raise UserError("Allowlist-Adapter bestätigte nicht exakt Host, Quell-IP und SSH-Port.")
    return received


def stop_helper(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is None:
        try:
            process.kill()
        except OSError:
            pass
    try:
        process.wait(timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        pass


def run_helper_bounded(command: Sequence[str], timeout: int) -> subprocess.CompletedProcess[bytes]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=helper_environment(),
    )
    if process.stdout is None:
        stop_helper(process)
        raise OSError("Allowlist-Adapter hat keinen lesbaren stdout-Kanal.")

    output = bytearray()
    deadline = time.monotonic() + timeout
    descriptor = process.stdout.fileno()
    try:
        os.set_blocking(descriptor, False)
        while True:
            try:
                chunk = os.read(descriptor, min(4096, MAX_HELPER_OUTPUT + 1 - len(output)))
            except BlockingIOError:
                chunk = None

            if chunk == b"":
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout)
                try:
                    returncode = process.wait(timeout=remaining)
                except subprocess.TimeoutExpired:
                    raise subprocess.TimeoutExpired(command, timeout) from None
                return subprocess.CompletedProcess(command, returncode, bytes(output), b"")
            if chunk:
                output.extend(chunk)
                if len(output) > MAX_HELPER_OUTPUT:
                    raise UserError(
                        "Allowlist-Adapter überschritt das feste 4096-Byte-Antwortlimit; SSH wird nicht gestartet."
                    )
            if time.monotonic() >= deadline:
                raise subprocess.TimeoutExpired(command, timeout)
            if chunk is None:
                time.sleep(0.02)
    except BaseException:
        stop_helper(process)
        raise
    finally:
        process.stdout.close()


def acquire_lease(
    helper: Path,
    *,
    host: str,
    source_cidr: str,
    ssh_port: int,
    ttl: int,
) -> Lease:
    expected = Lease(lease_id="pending", host=host, source_cidr=source_cidr, ssh_port=ssh_port)
    command = [
        str(helper),
        "acquire",
        "--host",
        host,
        "--source-cidr",
        source_cidr,
        "--ssh-port",
        str(ssh_port),
        "--ttl-seconds",
        str(ttl),
    ]
    try:
        result = run_helper_bounded(command, HELPER_ACQUIRE_TIMEOUT)
    except subprocess.TimeoutExpired as exc:
        raise UserError("Allowlist-Adapter überschritt das feste Zeitlimit; SSH wird nicht gestartet.") from exc
    except OSError as exc:
        raise UserError("Allowlist-Adapter konnte nicht gestartet werden.") from exc
    if result.returncode != 0:
        raise UserError(
            f"Allowlist-Adapter verweigerte die Firewall-Freigabe (Exit {result.returncode}); SSH wird nicht gestartet."
        )
    try:
        return parse_lease(result.stdout, expected)
    except UserError:
        # a helper may have created a lease before returning a malformed or
        # mismatched confirmation. revoke a syntactically safe ID when
        # possible; the mandatory provider TTL remains the final backstop.
        try:
            document = json.loads(result.stdout.decode("utf-8"))
            lease_id = document.get("lease_id") if isinstance(document, dict) else None
        except (UnicodeError, json.JSONDecodeError):
            lease_id = None
        if isinstance(lease_id, str) and LEASE_ID_RE.fullmatch(lease_id):
            release_lease(
                helper,
                Lease(
                    lease_id=lease_id,
                    host=host,
                    source_cidr=source_cidr,
                    ssh_port=ssh_port,
                ),
            )
        raise


def release_lease(helper: Path, lease: Lease) -> bool:
    command = [str(helper), "release", "--lease-id", lease.lease_id]
    try:
        result = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=HELPER_RELEASE_TIMEOUT,
            env=helper_environment(),
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def connector_environment() -> dict[str, str]:
    """keep provider credentials and python/shell injection variables out of SSH."""

    environment = {"PATH": SAFE_SYSTEM_PATH}
    for name in ("HOME", "USER", "LOGNAME", "LANG", "TERM", "TZ"):
        value = os.environ.get(name)
        if value:
            environment[name] = value
    for name in ("LC_ALL", "LC_CTYPE", "LC_MESSAGES"):
        value = os.environ.get(name)
        if value:
            environment[name] = value
    return environment


def helper_environment() -> dict[str, str]:
    """preserve provider credentials but remove interpreter injection knobs."""

    environment = os.environ.copy()
    exact = {
        "BASH_ENV",
        "CDPATH",
        "ENV",
        "GCONV_PATH",
        "IFS",
        "NODE_OPTIONS",
        "PERL5LIB",
        "PERLLIB",
        "RUBYLIB",
        "RUBYOPT",
        "ZDOTDIR",
    }
    prefixes = ("DYLD_", "LD_", "PYTHON")
    for name in list(environment):
        if name in exact or name.startswith(prefixes):
            environment.pop(name, None)
    environment["PATH"] = SAFE_SYSTEM_PATH
    return environment


def choose_browser_build_mode(
    script_directory: Path,
    *,
    accept_disposable_test: bool,
) -> BrowserBuildMode:
    maintenance = script_directory / "browser-maintenance.py"
    if not maintenance.is_file() or maintenance.is_symlink():
        raise UserError(f"Browser-Sicherheitsgate fehlt oder ist unsicher: {maintenance}")
    python = resolve_executable(None, name="python3", fallback=Path("/usr/bin/python3"))
    command = [str(python), "-I", str(maintenance)]
    try:
        release = subprocess.run(
            [*command, "release"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=30,
            env=connector_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UserError("Lokales Browser-Sicherheitsgate konnte nicht ausgeführt werden.") from exc
    if len(release.stdout) > MAX_REMOTE_OUTPUT:
        raise UserError("Lokales Browser-Sicherheitsgate lieferte unerwartet viel Ausgabe.")
    if release.returncode == 0:
        write_stderr(release.stdout.decode("utf-8", errors="replace").rstrip())
        return BrowserBuildMode(disposable_test=False)

    try:
        disposable = subprocess.run(
            [*command, "disposable-test"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=30,
            env=connector_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UserError("Disposable-Testgate konnte nicht ausgeführt werden.") from exc
    combined = release.stdout + disposable.stdout
    if len(combined) > 2 * MAX_REMOTE_OUTPUT:
        raise UserError("Browser-Testgate lieferte unerwartet viel Ausgabe.")
    text = combined.decode("utf-8", errors="replace").rstrip()
    if disposable.returncode != 0:
        write_stderr(text)
        raise UserError(
            "Der Browserstand ist weder releasefähig noch als eng begrenzter Disposable-Testbuild zulässig."
        )
    write_tty(
        "\n=== DISPOSABLE BROWSER-TEST ===\n"
        + text
        + "\n\nDer aktuelle Camoufox/Gecko-Stand ist NICHT sicherheitsfreigegeben.\n"
        "Er darf nur auf dieser Wegwerf-VM für einen Funktionstest ohne sensible\n"
        "Accounts, Passwörter oder Daten verwendet werden. Das normale Release-Gate\n"
        "bleibt blockiert und wird nicht verändert.\n"
    )
    if not accept_disposable_test and not confirm_tty(
        "Diesen klar markierten Disposable-Testbuild verwenden?", default_yes=True
    ):
        raise UserError("Disposable-Testbuild wurde nicht freigegeben.")
    return BrowserBuildMode(disposable_test=True)


def build_provision_artifacts(
    script_directory: Path,
    architecture: str,
    mode: BrowserBuildMode,
    build_root: Path,
) -> ProvisionArtifacts:
    if architecture not in {"amd64", "arm64"}:
        raise UserError(f"Nicht unterstützte VM-Architektur: {architecture}")
    ssh_builder = resolve_executable(
        str(script_directory.parent / "ssh" / "make-toolkit-release.sh"),
        name="make-toolkit-release.sh",
    )
    pbp_builder = resolve_executable(
        str(script_directory / "make-release.sh"),
        name="make-release.sh",
    )
    ssh_output = build_root / "ssh"
    pbp_output = build_root / "pbp"
    build_environment = connector_environment()
    build_environment["TOOLKIT_DIST_DIR"] = str(ssh_output)
    write_stderr("  SSH-/GUI-Paket prüfen und verpacken …")
    try:
        ssh_result = subprocess.run(
            [str(ssh_builder)],
            stdout=subprocess.DEVNULL,
            check=False,
            env=build_environment,
        )
    except OSError as exc:
        raise UserError("SSH-/GUI-Artefaktbuilder konnte nicht gestartet werden.") from exc
    if ssh_result.returncode != 0:
        raise UserError(f"SSH-/GUI-Artefaktbuild schlug fehl (Exit {ssh_result.returncode}).")

    build_environment["TOOLKIT_DIST_DIR"] = str(pbp_output)
    pbp_arguments = [str(pbp_builder)]
    if mode.disposable_test:
        pbp_arguments.append("--disposable-test-run")
    pbp_arguments.append(architecture)
    write_stderr(f"  PBP-Paket für linux-{architecture} prüfen und verpacken …")
    try:
        pbp_result = subprocess.run(
            pbp_arguments,
            stdout=subprocess.DEVNULL,
            check=False,
            env=build_environment,
        )
    except OSError as exc:
        raise UserError("PBP-Artefaktbuilder konnte nicht gestartet werden.") from exc
    if pbp_result.returncode != 0:
        raise UserError(f"PBP-Artefaktbuild schlug fehl (Exit {pbp_result.returncode}).")

    ssh_archive, ssh_digest = validate_local_artifact(ssh_output / "ssh.tar.gz", "SSH-/GUI-Artefakt")
    if mode.disposable_test:
        pbp_path = pbp_output / "disposable-test" / f"linux-{architecture}" / "pbp-disposable-test.tar.gz"
    else:
        pbp_path = pbp_output / f"linux-{architecture}" / "pbp.tar.gz"
    pbp_archive, pbp_digest = validate_local_artifact(pbp_path, "PBP-Artefakt")
    write_stderr(f"  OK SSH-/GUI-Artefakt: {path_size(ssh_archive, 'SSH-/GUI-Artefakt')}")
    write_stderr(f"  OK PBP-Artefakt:      {path_size(pbp_archive, 'PBP-Artefakt')}")
    return ProvisionArtifacts(
        ssh_archive=ssh_archive,
        pbp_archive=pbp_archive,
        ssh_sha256=ssh_digest,
        pbp_sha256=pbp_digest,
    )


