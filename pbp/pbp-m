    except (OSError, UnicodeError) as exc:
        raise UserError(
            "Die manuellen Firewall-Anweisungen können nicht sicher am kontrollierenden /dev/tty angezeigt werden."
        ) from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)


