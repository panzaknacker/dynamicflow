def validate_port(value: str) -> int:
    try:
        port = int(value, 10)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("Port muss eine Zahl sein.") from exc
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("Port muss zwischen 1 und 65535 liegen.")
    return port


def validate_ttl(value: str) -> int:
    try:
        ttl = int(value, 10)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("TTL muss eine Zahl sein.") from exc
    if not 300 <= ttl <= 86_400:
        raise argparse.ArgumentTypeError("TTL muss zwischen 300 und 86400 Sekunden liegen.")
    return ttl


def normalize_host(raw_host: str) -> str:
    host = raw_host
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    if not host or len(host) > 253 or any(character.isspace() for character in host):
        raise UserError("Zielhost ist leer, zu lang oder enthält Leerraum.")
    if host.startswith("-") or "/" in host or "\\" in host or "\x00" in host:
        raise UserError("Zielhost enthält unzulässige Zeichen.")
    try:
        address = ipaddress.ip_address(host)
    except ValueError as exc:
        raise UserError("Ziel muss eine literale, global routbare öffentliche IP-Adresse sein.") from exc
    if address.version != 4:
        raise UserError(
            "PBP deaktiviert IPv6 systemweit; Ziel muss eine global routbare öffentliche IPv4-Adresse sein."
        )
    if (
        not address.is_global
        or address.is_multicast
        or address.is_unspecified
        or address.is_loopback
        or address.is_link_local
        or getattr(address, "scope_id", None) is not None
        or getattr(address, "ipv4_mapped", None) is not None
    ):
        raise UserError("Ziel muss eine literale, global routbare öffentliche IP-Adresse sein.")
    return address.compressed


def normalize_target(raw_target: str, default_user: str) -> Target:
    target = raw_target.strip()
    if not target or target.startswith("-") or target.count("@") > 1:
        raise UserError("Ziel muss IP oder USER@IP sein.")
    if "@" in target:
        user, raw_host = target.split("@", 1)
    else:
        user, raw_host = default_user, target
    if not SSH_USER_RE.fullmatch(user) or user == "root":
        raise UserError("SSH-Benutzer ist ungültig; Root-Login ist nicht erlaubt.")
    return Target(user=user, host=normalize_host(raw_host))


def normalize_source_ip(raw_source: str) -> str:
    source = raw_source.strip()
    if not source or any(character.isspace() for character in source):
        raise UserError("Access-IP ist leer oder enthält Leerraum.")
    try:
        if "/" in source:
            interface = ipaddress.ip_interface(source)
            address = interface.ip
            if interface.network.prefixlen != address.max_prefixlen:
                raise UserError("Die SSH-Allowlist akzeptiert nur genau eine IPv4-Adresse (/32), kein breites Netz.")
        else:
            address = ipaddress.ip_address(source)
    except ValueError as exc:
        raise UserError("Access-IP ist keine gültige IPv4-Adresse.") from exc
    if address.version != 4:
        raise UserError("PBP deaktiviert IPv6 systemweit; Access-IP muss eine global routbare IPv4-Adresse (/32) sein.")
    if (
        not address.is_global
        or address.is_multicast
        or address.is_unspecified
        or address.is_loopback
        or address.is_link_local
        or getattr(address, "scope_id", None) is not None
        or getattr(address, "ipv4_mapped", None) is not None
    ):
        raise UserError("Access-IP muss eine global routbare, öffentliche IPv4-Adresse sein.")
    return f"{address.compressed}/32"


def prompt(message: str) -> str:
    try:
        return input(message)
    except (EOFError, KeyboardInterrupt) as exc:
        raise UserError("Interaktive Eingabe wurde abgebrochen.") from exc


def prompt_tty(message: str) -> str:
    """read security attestations only from the controlling terminal."""

    descriptor: int | None = None
    try:
        descriptor = os.open("/dev/tty", os.O_RDWR | getattr(os, "O_CLOEXEC", 0))
        if not os.isatty(descriptor):
            raise UserError("/dev/tty ist kein kontrollierendes Terminal.")
        write_descriptor(descriptor, message.encode("utf-8", errors="strict"))
        answer = bytearray()
        while True:
            unit = os.read(descriptor, 1)
            if not unit:
                raise UserError("Interaktive Terminal-Eingabe wurde abgebrochen.")
            if unit == b"\n":
                break
            answer.extend(unit)
            if len(answer) > 512:
                raise UserError("Interaktive Terminal-Eingabe ist zu lang.")
        return answer.decode("utf-8", errors="strict").rstrip("\r")
    except UserError:
        raise
    except (OSError, UnicodeError, KeyboardInterrupt) as exc:
        raise UserError(
            "Der manuelle Firewall-Modus benötigt ein kontrollierendes /dev/tty; "
            "Pipe-/stdin-Bestätigungen werden nicht akzeptiert."
        ) from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)


def write_descriptor(descriptor: int, payload: bytes) -> None:
    position = 0
    while position < len(payload):
        written = os.write(descriptor, payload[position:])
        if written <= 0:
            raise OSError("Terminalausgabe wurde vorzeitig beendet.")
        position += written


def write_tty(message: str) -> None:
    descriptor: int | None = None
    try:
        descriptor = os.open("/dev/tty", os.O_WRONLY | getattr(os, "O_CLOEXEC", 0))
