[Unit]
Description=Toolkit TOTP download token broker
After=local-fs.target
Before=caddy.service

[Service]
Type=simple
User=toolkit-auth
Group=caddy
RuntimeDirectory=toolkit-auth
RuntimeDirectoryMode=0750
StateDirectory=toolkit-auth
StateDirectoryMode=0700
LoadCredentialEncrypted=users:/etc/credstore.encrypted/toolkit-users.cred
ExecStart=/usr/bin/python3 /usr/local/libexec/toolkit_auth.py serve --socket /run/toolkit-auth/auth.sock --config %d/users --state /var/lib/toolkit-auth/state.json --token-ttl 600
Restart=on-failure
RestartSec=2s
UMask=0007

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
